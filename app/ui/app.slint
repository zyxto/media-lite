// Interfaz de media-lite. Todo el estado vive en Rust; acá solo se dibuja y se avisan los clics.
// GPL-3.0-or-later.

import { ListView, ScrollView } from "std-widgets.slint";
// Inter (SIL OFL 1.1, ver app/assets/fonts/OFL.txt): Slint las embebe en el binario.
import "../assets/fonts/Inter-Regular.ttf";
import "../assets/fonts/Inter-SemiBold.ttf";

// Qué está haciendo la app mientras no hay un video reproduciéndose. Lo fija Rust.
export enum Activity {
    idle,
    // Pidiendo un listado, una búsqueda o las temporadas de una serie.
    catalog,
    // Pidiendo la fuente de un video, antes de que mpv se abra.
    preparing,
}

// Escala de espacios: 4, 8, 12, 16 y 24 px. Tipos: 11, 12, 13, 14, 18 y 22 px.
// Los estados (hover, pulsado) salen de aclarar u oscurecer el color base.
export global Theme {
    in-out property <bool> dark: true;
    out property <color> bg: dark ? #0f1115 : #f2f3f6;
    out property <color> side: dark ? #14171d : #e4e7ee;
    out property <color> surface: dark ? #1b1f28 : #ffffff;
    out property <color> surface-hi: dark ? #272d39 : #d9dde7;
    out property <color> hover: dark ? #222733 : #e9ecf3;
    out property <color> text: dark ? #e9ebf1 : #15171c;
    out property <color> muted: dark ? #8d95a7 : #5a6273;
    out property <color> accent: #7c9cff;
    out property <color> accent-hover: accent.brighter(0.15);
    out property <color> accent-press: accent.darker(0.2);
    out property <color> error: dark ? #ff8a80 : #c62828;
    out property <length> radius: 10px;
}

// Un programa de la guía: su hora local, su título y si está al aire.
export struct GuideRow {
    time: string,
    title: string,
    current: bool,
}

// Una línea de la letra: su texto y si es la que suena.
export struct LyricRow {
    text: string,
    current: bool,
}

// Una línea del chat: autor y texto. `notice` es un aviso del sistema (suscripciones, cortes).
export struct ChatLine {
    author: string,
    text: string,
    color: color,
    notice: bool,
}

export struct CardData {
    title: string,
    subtitle: string,
    thumb: image,
    has-thumb: bool,
    index: int,
}

// Una fila de Ajustes. `group` va solo en la primera de cada grupo y pone su título arriba.
export struct SettingRow {
    group: string,
    label: string,
    value: string,
    note: string,
    // Interruptor de sí / no (`on` es su estado).
    switch: bool,
    on: bool,
    // Botón de acción en lugar de un valor.
    action: bool,
}

// Una entrada de la lista de secciones: solo las que tiene la plataforma elegida. `index` es el
// lugar de la sección en la lista completa.
export struct SectionEntry {
    label: string,
    index: int,
}

export struct RowData {
    cards: [CardData],
}

// Un episodio en la lista de la pantalla de una serie.
export struct EpisodeData {
    number: string,
    title: string,
    meta: string,
    description: string,
    thumb: image,
    has-thumb: bool,
    index: int,
}

// Ícono dibujado con trazos propios (la app no lleva un set de íconos ni el soporte de SVG). Se tiñe
// con `color`, así sigue al tema. Todos están pensados en una caja de 24 × 24.
component Icon inherits Rectangle {
    in property <string> glyph;
    in property <color> tint: Theme.text;
    in property <length> size: 18px;

    width: root.size;
    height: root.size;

    // Rellenos
    if root.glyph == "play" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; fill: root.tint; commands: "M8 5 L19 12 L8 19 Z"; }
    if root.glyph == "pause" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; fill: root.tint; commands: "M7 5 H10.5 V19 H7 Z M13.5 5 H17 V19 H13.5 Z"; }
    if root.glyph == "stop" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; fill: root.tint; commands: "M6.5 6.5 H17.5 V17.5 H6.5 Z"; }
    if root.glyph == "prev" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; fill: root.tint; commands: "M6 5 H8.5 V19 H6 Z M19 5 V19 L9.5 12 Z"; }
    if root.glyph == "next" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; fill: root.tint; commands: "M15.5 5 H18 V19 H15.5 Z M5 5 L14.5 12 L5 19 Z"; }
    if root.glyph == "rewind" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; fill: root.tint; commands: "M11.5 6 V18 L3.5 12 Z M20.5 6 V18 L12.5 12 Z"; }
    if root.glyph == "forward" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; fill: root.tint; commands: "M3.5 6 V18 L11.5 12 Z M12.5 6 V18 L20.5 12 Z"; }
    if root.glyph == "volume-down" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; fill: root.tint; commands: "M3 9.5 H7 L12 5 V19 L7 14.5 H3 Z M15.5 11 H21 V13 H15.5 Z"; }
    if root.glyph == "volume-up" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; fill: root.tint; commands: "M3 9.5 H7 L12 5 V19 L7 14.5 H3 Z M15.5 11 H21 V13 H15.5 Z M17.25 9.25 H19.25 V14.75 H17.25 Z"; }
    if root.glyph == "moon" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; fill: root.tint; commands: "M20 14.5 A8 8 0 1 1 9.5 4 A6.5 6.5 0 0 0 20 14.5 Z"; }
    if root.glyph == "heart" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; fill: root.tint; commands: "M12 20 C4 14.5 3 9.5 6.5 6.8 C9 5 11.2 6 12 8 C12.8 6 15 5 17.5 6.8 C21 9.5 20 14.5 12 20 Z"; }

    // Trazos
    if root.glyph == "fullscreen" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M4 9 V4 H9 M15 4 H20 V9 M20 15 V20 H15 M9 20 H4 V15"; }
    if root.glyph == "shuffle" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M3 7 H7 C12 7 11 17 16 17 H21 M18 14 L21 17 L18 20 M3 17 H7 C9 17 10 15.5 10.7 14 M13.3 10 C14 8.5 15 7 17 7 H21 M18 4 L21 7 L18 10"; }
    if root.glyph == "repeat" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M4 11 V9.5 A3.5 3.5 0 0 1 7.5 6 H20 M17 3 L20 6 L17 9 M20 13 V14.5 A3.5 3.5 0 0 1 16.5 18 H4 M7 15 L4 18 L7 21"; }
    if root.glyph == "subtitles" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M3 5.5 H21 V18.5 H3 Z M6.5 11 H10 M13 11 H17.5 M6.5 14.5 H12 M15 14.5 H17.5"; }
    if root.glyph == "audio" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M4 16 V12 A8 8 0 0 1 20 12 V16 M3.5 14 H7.5 V20 H3.5 Z M16.5 14 H20.5 V20 H16.5 Z"; }
    if root.glyph == "lyrics" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M4 6 H20 M4 10.5 H20 M4 15 H20 M4 19.5 H13"; }
    if root.glyph == "expand" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M14 4 H20 V10 M10 20 H4 V14 M20 4 L13 11 M4 20 L11 13"; }
    if root.glyph == "collapse" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M20 10 H14 V4 M4 14 H10 V20 M14 10 L21 3 M10 14 L3 21"; }
    if root.glyph == "close" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M6 6 L18 18 M18 6 L6 18"; }
    if root.glyph == "back" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M20 12 H5 M11 6 L5 12 L11 18"; }
    if root.glyph == "plus" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M12 5 V19 M5 12 H19"; }
    if root.glyph == "check" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M5 12.5 L10 17.5 L19 7"; }
    if root.glyph == "refresh" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M20 12 A8 8 0 1 1 17.5 6.2 M18.5 2.5 V7.5 H13.5"; }
    if root.glyph == "search" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M10.5 4 A6.5 6.5 0 1 1 10.5 17 A6.5 6.5 0 1 1 10.5 4 Z M15.3 15.3 L20 20"; }
    if root.glyph == "home" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M4 11 L12 4 L20 11 V20 H14.5 V14 H9.5 V20 H4 Z"; }
    if root.glyph == "history" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M12 3.5 A8.5 8.5 0 1 1 12 20.5 A8.5 8.5 0 1 1 12 3.5 Z M12 7.5 V12.5 L15.5 14.5"; }
    if root.glyph == "heart-outline" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M12 20 C4 14.5 3 9.5 6.5 6.8 C9 5 11.2 6 12 8 C12.8 6 15 5 17.5 6.8 C21 9.5 20 14.5 12 20 Z"; }
    if root.glyph == "bell" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M6 17 V11 A6 6 0 0 1 18 11 V17 L19.5 18.5 H4.5 Z M10 21 A2 2 0 0 0 14 21"; }
    if root.glyph == "sliders" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M4 7 H9 M15 7 H20 M4 17 H13 M19 17 H20 M12 4.5 V9.5 H9 V4.5 Z M16 14.5 V19.5 H13 V14.5 Z"; }
    if root.glyph == "sun" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M12 8 A4 4 0 1 1 12 16 A4 4 0 1 1 12 8 Z M12 2.5 V4.5 M12 19.5 V21.5 M2.5 12 H4.5 M19.5 12 H21.5 M5.3 5.3 L6.7 6.7 M17.3 17.3 L18.7 18.7 M5.3 18.7 L6.7 17.3 M17.3 6.7 L18.7 5.3"; }
    if root.glyph == "live" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M12 9.8 A2.2 2.2 0 1 1 12 14.2 A2.2 2.2 0 1 1 12 9.8 Z M7.3 7.3 A6.6 6.6 0 0 0 7.3 16.7 M16.7 7.3 A6.6 6.6 0 0 1 16.7 16.7 M4.2 4.5 A11 11 0 0 0 4.2 19.5 M19.8 4.5 A11 11 0 0 1 19.8 19.5"; }
    if root.glyph == "movies" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M4 5 H20 V19 H4 Z M8 5 V19 M16 5 V19 M4 9.5 H8 M4 14.5 H8 M16 9.5 H20 M16 14.5 H20"; }
    if root.glyph == "series" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M4 16 V5 H15 M8 9 H20 V20 H8 Z"; }
    if root.glyph == "videos" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M3 6 H21 V18 H3 Z M10 9 L15.5 12 L10 15 Z"; }
    if root.glyph == "music" : Path { width: root.size; height: root.size; viewbox-width: 24; viewbox-height: 24; stroke: root.tint; stroke-width: 1.8px; commands: "M9 17.5 V5.5 L19 3.5 V15.5 M6 14.8 A3 2.7 0 1 1 6 20.2 A3 2.7 0 1 1 6 14.8 Z M16 12.8 A3 2.7 0 1 1 16 18.2 A3 2.7 0 1 1 16 12.8 Z"; }
}

// Botón redondo con un ícono. Con `hint` muestra su nombre al pasar el mouse, porque sin texto no se
// sabría qué hace. `primary` lo pinta de acento; `active` tiñe el ícono (aleatorio prendido, por ejemplo).
component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <string> hint;
    in property <string> badge;
    in property <bool> active: false;
    in property <bool> available: true;
    in property <bool> primary: false;
    in property <length> diameter: 36px;
    callback clicked();

    width: root.diameter;
    height: root.diameter;
    border-radius: root.diameter / 2;
    background: root.primary
        ? (touch.pressed ? Theme.accent-press : touch.has-hover ? Theme.accent-hover : Theme.accent)
        : touch.pressed ? Theme.surface-hi
        : touch.has-hover ? Theme.hover
        : transparent;
    opacity: root.available ? 1 : 0.35;
    animate background { duration: 120ms; }

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        glyph: root.glyph;
        size: root.primary ? 20px : 18px;
        tint: root.primary ? #ffffff : root.active ? Theme.accent : Theme.text;
    }

    if root.badge != "" : Text {
        x: parent.width - 15px;
        y: parent.height - 15px;
        text: root.badge;
        color: root.active ? Theme.accent : Theme.muted;
        font-size: 9px;
        font-weight: 700;
    }

    // El nombre del botón, arriba de él.
    if touch.has-hover && root.hint != "" && root.available : Rectangle {
        x: (parent.width - self.width) / 2;
        y: -30px;
        width: hint-text.preferred-width + 16px;
        height: 24px;
        border-radius: 6px;
        background: Theme.surface-hi;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000060;

        hint-text := Text {
            x: 8px;
            height: parent.height;
            text: root.hint;
            color: Theme.text;
            font-size: 11px;
            vertical-alignment: center;
            wrap: no-wrap;
        }
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.available;
        mouse-cursor: root.available ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Entrada de la barra lateral. Marca la activa con una franja a la izquierda y se aclara al pasar el mouse.
component NavButton inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> active;
    callback clicked();

    height: 34px;
    border-radius: 8px;
    background: root.active ? Theme.surface-hi
        : touch.pressed ? Theme.surface-hi
        : touch.has-hover ? Theme.hover
        : transparent;
    animate background { duration: 120ms; }

    Rectangle {
        x: 0px;
        y: parent.height * 0.25;
        width: 3px;
        height: parent.height * 0.5;
        border-radius: 2px;
        background: root.active ? Theme.accent : transparent;
    }

    Icon {
        x: 14px;
        y: (parent.height - self.height) / 2;
        glyph: root.glyph;
        size: 16px;
        tint: root.active ? Theme.accent : Theme.muted;
        visible: root.glyph != "";
    }

    Text {
        x: root.glyph == "" ? 14px : 40px;
        width: parent.width - self.x - 12px;
        height: parent.height;
        text: root.label;
        color: root.active ? Theme.text : Theme.muted;
        font-size: 14px;
        font-weight: root.active ? 600 : 400;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component CardView inherits Rectangle {
    in property <CardData> data;
    in property <length> card-width;
    callback activated();

    width: root.card-width;
    height: root.card-width * 9 / 16 + 48px;

    VerticalLayout {
        spacing: 6px;

        Rectangle {
            height: root.card-width * 9 / 16;
            border-radius: Theme.radius;
            clip: true;
            background: Theme.surface-hi;
            border-width: touch.has-hover ? 2px : 0px;
            border-color: Theme.accent;
            animate border-width { duration: 120ms; }

            Image {
                width: parent.width;
                height: parent.height;
                source: root.data.thumb;
                image-fit: cover;
                visible: root.data.has-thumb;
            }

            // Al pasar el mouse: un velo con la acción, así se ve qué tarjeta es la que se va a abrir.
            Rectangle {
                width: parent.width;
                height: parent.height;
                background: touch.pressed ? #000000a0 : #00000040;
                opacity: touch.has-hover ? 1 : 0;
                animate opacity { duration: 120ms; }

                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: Theme.accent;

                    Icon {
                        x: (parent.width - self.width) / 2 + 1px;
                        y: (parent.height - self.height) / 2;
                        glyph: "play";
                        size: 20px;
                        tint: #ffffff;
                    }
                }
            }
        }

        Text {
            text: root.data.title;
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
            wrap: no-wrap;
            overflow: elide;
        }

        Text {
            text: root.data.subtitle;
            color: Theme.muted;
            font-size: 11px;
            wrap: no-wrap;
            overflow: elide;
        }
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

// Marcador de una tarjeta mientras carga el catálogo. Pulsa al mismo ritmo que el resto.
component CardSkeleton inherits Rectangle {
    in property <length> card-width;
    in property <bool> pulse;

    width: root.card-width;
    height: root.card-width * 9 / 16 + 48px;

    VerticalLayout {
        spacing: 6px;

        Rectangle {
            height: root.card-width * 9 / 16;
            border-radius: Theme.radius;
            background: Theme.surface-hi;
            opacity: root.pulse ? 0.45 : 1;
            animate opacity { duration: 700ms; easing: ease-in-out; }
        }

        Rectangle {
            height: 12px;
            width: parent.width * 0.8;
            border-radius: 4px;
            background: Theme.surface-hi;
            opacity: root.pulse ? 0.45 : 1;
            animate opacity { duration: 700ms; easing: ease-in-out; }
        }

        Rectangle {
            height: 10px;
            width: parent.width * 0.5;
            border-radius: 4px;
            background: Theme.surface-hi;
            opacity: root.pulse ? 0.45 : 1;
            animate opacity { duration: 700ms; easing: ease-in-out; }
        }
    }
}

// Botón de acción. Primario o secundario; se deshabilita con `available`.
component PlayButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> available: true;
    callback clicked();

    min-width: 64px;
    height: 34px;
    border-radius: 8px;
    background: !root.available ? Theme.surface-hi
        : root.primary ? (touch.pressed ? Theme.accent-press : touch.has-hover ? Theme.accent-hover : Theme.accent)
        : touch.pressed ? Theme.surface
        : touch.has-hover ? Theme.hover
        : Theme.surface-hi;
    opacity: root.available ? 1 : 0.4;
    animate background { duration: 120ms; }

    Text {
        x: 2px;
        width: parent.width - 4px;
        height: parent.height;
        text: root.label;
        color: root.primary ? #ffffff : Theme.text;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: no-wrap;
        overflow: elide;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.available;
        mouse-cursor: root.available ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Botón grande de la pantalla de un título: ícono y texto. El principal va en el color de acento.
component HeroButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> available: true;
    callback clicked();

    height: 40px;
    width: 18px + (root.glyph == "" ? 0px : 20px + 8px) + label-text.preferred-width + 18px;
    border-radius: 8px;
    background: !root.available ? Theme.surface-hi
        : root.primary ? (touch.pressed ? Theme.accent-press : touch.has-hover ? Theme.accent-hover : Theme.accent)
        : touch.pressed ? Theme.surface
        : touch.has-hover ? Theme.hover
        : Theme.surface-hi;
    opacity: root.available ? 1 : 0.5;
    animate background { duration: 120ms; }

    Icon {
        x: 18px;
        y: (parent.height - self.height) / 2;
        glyph: root.glyph;
        size: 20px;
        tint: root.primary ? #ffffff : Theme.text;
        visible: root.glyph != "";
    }

    label-text := Text {
        x: 18px + (root.glyph == "" ? 0px : 20px + 8px);
        height: parent.height;
        text: root.label;
        color: root.primary ? #ffffff : Theme.text;
        font-size: 14px;
        font-weight: 600;
        vertical-alignment: center;
        wrap: no-wrap;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.available;
        mouse-cursor: root.available ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Un episodio: número, miniatura, título con su duración y sinopsis. Un clic lo reproduce.
component EpisodeRow inherits Rectangle {
    in property <EpisodeData> data;
    callback clicked();

    height: 104px;
    border-radius: 10px;
    background: touch.pressed ? Theme.surface-hi : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding: 12px;
        spacing: 16px;

        Text {
            width: 28px;
            text: root.data.number;
            color: Theme.muted;
            font-size: 20px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            width: 142px;
            border-radius: 8px;
            clip: true;
            background: Theme.surface-hi;

            Image {
                width: parent.width;
                height: parent.height;
                source: root.data.thumb;
                image-fit: cover;
                visible: root.data.has-thumb;
            }

            // Al pasar el mouse: un velo con el botón de reproducir.
            Rectangle {
                width: parent.width;
                height: parent.height;
                background: #00000066;
                opacity: touch.has-hover ? 1 : 0;
                animate opacity { duration: 120ms; }

                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 34px;
                    height: 34px;
                    border-radius: 17px;
                    background: Theme.accent;

                    Icon {
                        x: (parent.width - self.width) / 2 + 1px;
                        y: (parent.height - self.height) / 2;
                        glyph: "play";
                        size: 16px;
                        tint: #ffffff;
                    }
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;

            HorizontalLayout {
                spacing: 12px;

                Text {
                    horizontal-stretch: 1;
                    text: root.data.title;
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    wrap: no-wrap;
                    overflow: elide;
                }

                Text {
                    text: root.data.meta;
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: no-wrap;
                }
            }

            // Tres renglones como mucho: lo que sobra se corta con «…».
            if root.data.description != "" : Text {
                text: root.data.description;
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
                overflow: elide;
                max-height: 44px;
            }
        }
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Fila de la pantalla de Ajustes: nombre y nota a la izquierda; a la derecha, el control (interruptor,
// valor o botón). La primera de cada grupo lleva el título del grupo arriba.
component SettingRowView inherits Rectangle {
    in property <SettingRow> data;
    in property <int> index;
    callback clicked(int);

    height: (root.data.group == "" ? 0px : 40px) + 56px;

    if root.data.group != "" : Text {
        y: 14px;
        x: 4px;
        text: root.data.group;
        color: Theme.accent;
        font-size: 12px;
        font-weight: 700;
    }

    card := Rectangle {
        y: root.data.group == "" ? 0px : 40px;
        height: 56px;
        border-radius: 10px;
        background: touch.pressed ? Theme.surface-hi : touch.has-hover ? Theme.hover : Theme.surface;
        animate background { duration: 120ms; }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 12px;

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;

                Text {
                    text: root.data.label;
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    wrap: no-wrap;
                    overflow: elide;
                }

                Text {
                    text: root.data.note;
                    color: Theme.muted;
                    font-size: 11px;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }

            VerticalLayout {
                alignment: center;

                // Interruptor
                if root.data.switch : Rectangle {
                    width: 44px;
                    height: 24px;
                    border-radius: 12px;
                    background: root.data.on ? Theme.accent : Theme.surface-hi;
                    animate background { duration: 150ms; }

                    Rectangle {
                        x: root.data.on ? parent.width - self.width - 3px : 3px;
                        y: 3px;
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: root.data.on ? #ffffff : Theme.muted;
                        animate x { duration: 150ms; easing: ease-out; }
                    }
                }

                // Valor que cambia con cada clic, o botón de acción
                if !root.data.switch : Rectangle {
                    width: max(110px, value-text.preferred-width + 28px);
                    height: 32px;
                    border-radius: 16px;
                    background: root.data.action ? Theme.accent : Theme.surface-hi;

                    value-text := Text {
                        x: 14px;
                        height: parent.height;
                        text: root.data.value;
                        color: root.data.action ? #ffffff : Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                        wrap: no-wrap;
                    }
                }
            }
        }
    }

    touch := TouchArea {
        y: card.y;
        width: parent.width;
        height: card.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(root.index); }
    }
}

// Chip de categoría o de temporada.
component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();

    height: 30px;
    width: label-text.preferred-width + 24px;
    border-radius: 15px;
    background: root.active ? Theme.accent
        : touch.pressed ? Theme.surface-hi
        : touch.has-hover ? Theme.hover
        : Theme.surface;
    animate background { duration: 120ms; }

    label-text := Text {
        x: 12px;
        height: parent.height;
        text: root.label;
        color: root.active ? #ffffff : Theme.muted;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "media-lite";
    background: Theme.bg;
    default-font-family: "Inter";
    preferred-width: 1024px;
    preferred-height: 640px;
    // Lo mínimo para que quepan los nueve controles del reproductor en una fila sin cortar el texto.
    min-width: 940px;
    min-height: 440px;

    in property <[string]> platforms;
    in property <int> platform-index: 0;
    in property <[SectionEntry]> sections;
    in property <int> section-index: 1;
    in property <[RowData]> rows;
    in property <int> columns: 4;
    in property <string> status;
    in property <bool> status-error;
    in property <Activity> activity: Activity.idle;
    // Texto centrado cuando la lista está vacía o falló (ej.: «No se pudo cargar…»).
    in property <string> empty-message;
    in property <bool> detail-open;
    in property <string> detail-title;
    in property <string> detail-subtitle;
    in property <string> detail-text;
    in property <bool> playing;
    // Chat del directo o de la grabación, a la derecha de la grilla (ver app/src/chat.rs).
    in property <bool> chat-open;
    in property <[ChatLine]> chat-lines;
    // Letra sincronizada de la canción que suena (ver app/src/music.rs).
    in property <bool> lyrics-open;
    // Guía de programación del canal en vivo (Pluto TV), en el mismo lugar que el chat.
    in property <bool> guide-open;
    in property <[GuideRow]> guide-rows;
    in property <[LyricRow]> lyrics-rows;
    // Aleatorio y repetir, y su texto.
    in property <bool> shuffle-on;
    // 0: no repite, 1: la lista, 2: una.
    in property <int> repeat-mode: 0;
    // Hay una lista de dónde seguir (aleatorio y repetir tienen sentido).
    in property <bool> queue-controls: false;
    // Lo que suena es música: sin calidad, idioma ni subtítulos.
    in property <bool> audio-only: false;
    // Calidad que se está viendo ("480p"), para el botón de la barra.
    in property <string> quality-label: "480p";
    in property <string> play-title;
    in property <string> play-time;
    in property <float> play-progress;
    in property <bool> play-paused;
    in property <bool> play-buffering;
    in property <string> play-status;
    in property <[string]> chips;
    in property <bool> settings-open;
    in property <int> library-index: -1;
    in property <bool> detail-favorite;
    in property <string> favorite-label: "Favoritos";
    // Pantalla de un título: la miniatura de la tarjeta (se ve mientras llega la imagen grande),
    // la imagen grande, y si el título es una serie (con su lista de episodios).
    in property <image> detail-thumb;
    in property <bool> detail-has-thumb;
    in property <image> detail-image;
    in property <bool> detail-image-ready;
    in property <bool> detail-series;
    in property <string> detail-play-label: "Reproducir";
    in property <[EpisodeData]> episodes;
    in property <[SettingRow]> settings-rows;
    in property <int> chip-index: 0;
    in property <bool> can-step-prev;
    in property <bool> can-step-next;

    callback shuffle-requested();
    callback volume-requested(int);
    callback quality-requested();
    callback repeat-requested();
    callback play-requested();
    callback toggle-pause-requested();
    callback seek-requested(float);
    callback seek-to-requested(float);
    callback stop-requested();
    callback fullscreen-requested();
    callback audio-cycle-requested();
    callback subtitle-cycle-requested();
    callback prev-requested();
    callback next-requested();
    callback chip-clicked(int);
    callback settings-requested();
    callback library-clicked(int);
    callback favorite-requested();
    callback episode-clicked(int);
    callback visible-rows-changed(int, int);
    callback setting-clicked(int);

    callback platform-clicked(int);
    callback section-clicked(int);
    callback search-submitted(string);
    callback card-clicked(int);
    callback refresh-requested();
    callback back-requested();
    callback theme-toggled();
    callback width-changed(float);

    // La letra se puede ocultar con el botón de la barra, y ocupar todo el contenido para verla sola.
    property <bool> lyrics-visible: true;
    property <bool> lyrics-wide: false;
    property <bool> lyrics-shown: root.lyrics-open && root.lyrics-visible;
    // Una columna a la derecha (chat, guía o letra): la grilla le deja su lugar y no queda tapada.
    property <bool> side-panel: root.chat-open || root.guide-open || (root.lyrics-shown && !root.lyrics-wide);
    property <length> content-width: root.width - (root.side-panel ? 328px : 0px);
    // Cuánto mide el pie ocupado por la barra del reproductor (si está), para que los paneles no la tapen.
    property <length> panel-bottom: root.playing ? 144px : 20px;
    property <length> card-width: (root.content-width - 200px - 40px - (root.columns - 1) * 16px) / root.columns;

    // Cuántas columnas entran se decide en Rust, con el ancho que le queda a la grilla.
    changed content-width => { root.width-changed(root.content-width / 1px); }
    // Lugares del esqueleto: uno por columna. Lo fija Rust (ver `state::sync_skeleton`).
    in property <[int]> skeleton-slots;
    // Alterna cada 700 ms mientras algo carga o se está bufferizando: mueve la barra y pulsa los esqueletos.
    property <bool> pulse;
    property <bool> loading: root.activity != Activity.idle;

    Timer {
        interval: 700ms;
        running: root.loading || root.play-buffering;
        triggered => { root.pulse = !root.pulse; }
    }

    forward-focus: keys;

    keys := FocusScope {
        width: parent.width;
        height: parent.height;

        key-pressed(event) => {
            if (event.text == "/") {
                search.focus();
                return accept;
            }
            if (event.text == Key.F5) {
                root.refresh-requested();
                return accept;
            }
            if (event.text == Key.Return && root.detail-open && !root.settings-open && !search.has-focus) {
                root.play-requested();
                return accept;
            }
            if ((event.text == Key.Escape || event.text == Key.Backspace) && (root.detail-open || root.settings-open)) {
                root.back-requested();
                return accept;
            }
            // Controles del video: solo si el foco no está en el buscador.
            if (root.playing && !search.has-focus) {
                if (event.text == " ") {
                    root.toggle-pause-requested();
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    root.seek-requested(-10);
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    root.seek-requested(10);
                    return accept;
                }
                if (event.text == "<" && root.can-step-prev) {
                    root.prev-requested();
                    return accept;
                }
                if (event.text == ">" && root.can-step-next) {
                    root.next-requested();
                    return accept;
                }
            }
            return reject;
        }

        HorizontalLayout {
            // Barra lateral: la navegación se desplaza si no entra; Ajustes y Tema quedan siempre abajo.
            Rectangle {
                width: 200px;
                background: Theme.side;

                VerticalLayout {
                    padding: 16px;
                    spacing: 4px;

                    Text {
                        text: "media-lite";
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 700;
                        height: 32px;
                    }

                    ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: 4px;

                            Text {
                                text: "PLATAFORMAS";
                                color: Theme.muted;
                                font-size: 11px;
                                height: 26px;
                                vertical-alignment: bottom;
                            }

                            for name[i] in root.platforms : NavButton {
                                label: name;
                                active: i == root.platform-index;
                                clicked => { root.platform-clicked(i); }
                            }

                            if root.sections.length > 0 : Text {
                                text: "SECCIONES";
                                color: Theme.muted;
                                font-size: 11px;
                                height: 26px;
                                vertical-alignment: bottom;
                            }

                            for entry in root.sections : NavButton {
                                label: entry.label;
                                glyph: entry.index == 0 ? "live"
                                    : entry.index == 1 ? "movies"
                                    : entry.index == 2 ? "series"
                                    : entry.index == 3 ? "videos"
                                    : "music";
                                active: entry.index == root.section-index;
                                clicked => { root.section-clicked(entry.index); }
                            }

                            Text {
                                text: "BIBLIOTECA";
                                color: Theme.muted;
                                font-size: 11px;
                                height: 26px;
                                vertical-alignment: bottom;
                            }

                            NavButton {
                                label: "Inicio";
                                glyph: "home";
                                active: root.library-index == 0;
                                clicked => { root.library-clicked(0); }
                            }

                            NavButton {
                                label: "Historial";
                                glyph: "history";
                                active: root.library-index == 1;
                                clicked => { root.library-clicked(1); }
                            }

                            NavButton {
                                label: "Favoritos";
                                glyph: "heart-outline";
                                active: root.library-index == 2;
                                clicked => { root.library-clicked(2); }
                            }

                            NavButton {
                                label: "Siguiendo";
                                glyph: "bell";
                                active: root.library-index == 3;
                                clicked => { root.library-clicked(3); }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.surface-hi;
                    }

                    NavButton {
                        label: "Ajustes";
                        glyph: "sliders";
                        active: root.settings-open;
                        clicked => { root.settings-requested(); }
                    }

                    NavButton {
                        label: Theme.dark ? "Tema claro" : "Tema oscuro";
                        glyph: Theme.dark ? "sun" : "moon";
                        active: false;
                        clicked => { root.theme-toggled(); }
                    }
                }
            }

            // Contenido
            VerticalLayout {
                padding-left: 20px;
                padding-top: 20px;
                padding-bottom: 20px;
                padding-right: 20px;
                spacing: 8px;

                // Todo lo de arriba deja lugar a la columna de la derecha; la barra del reproductor, no.
                VerticalLayout {
                vertical-stretch: 1;
                padding-right: root.side-panel ? 328px : 0px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 12px;
                    height: 38px;

                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.surface;
                        border-radius: 8px;
                        border-width: search.has-focus ? 1px : 0px;
                        border-color: Theme.accent;

                        Icon {
                            x: 12px;
                            y: (parent.height - self.height) / 2;
                            glyph: "search";
                            size: 16px;
                            tint: Theme.muted;
                        }

                        Text {
                            x: 38px;
                            width: parent.width - 52px;
                            height: parent.height;
                            text: "Buscar…   (tecla /)";
                            color: Theme.muted;
                            font-size: 14px;
                            vertical-alignment: center;
                            visible: search.text == "";
                        }

                        search := TextInput {
                            x: 38px;
                            width: parent.width - 52px;
                            height: parent.height;
                            color: Theme.text;
                            font-size: 14px;
                            vertical-alignment: center;
                            accepted => { root.search-submitted(self.text); }
                        }
                    }

                    Rectangle {
                        width: 40px;
                        background: refresh-touch.pressed ? Theme.surface-hi : refresh-touch.has-hover ? Theme.hover : Theme.surface;
                        border-radius: 8px;
                        animate background { duration: 120ms; }

                        Icon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            glyph: "refresh";
                            size: 18px;
                        }

                        refresh-touch := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: pointer;
                            clicked => { root.refresh-requested(); }
                        }
                    }
                }

                // Barra de carga: siempre reserva su lugar (sin saltos) y se desliza mientras algo carga.
                Rectangle {
                    height: 3px;
                    border-radius: 2px;
                    clip: true;
                    background: Theme.surface-hi;
                    opacity: root.loading ? 1 : 0;
                    animate opacity { duration: 200ms; }

                    Rectangle {
                        width: parent.width * 0.25;
                        height: parent.height;
                        border-radius: 2px;
                        background: Theme.accent;
                        x: root.pulse ? parent.width * 0.75 : 0px;
                        animate x { duration: 700ms; easing: ease-in-out; }
                    }
                }

                Text {
                    text: root.status;
                    color: root.status-error ? Theme.error : Theme.muted;
                    font-size: 12px;
                    height: 16px;
                    wrap: no-wrap;
                    overflow: elide;
                }

                if root.chips.length > 0 && !root.settings-open && !root.detail-open : ScrollView {
                    height: 34px;
                    content-height: 30px;

                    HorizontalLayout {
                        spacing: 8px;
                        height: 30px;

                        for name[i] in root.chips : Chip {
                            label: name;
                            active: i == root.chip-index;
                            clicked => { root.chip-clicked(i); }
                        }
                    }
                }

                // Área de contenido: un solo lugar donde se muestra la grilla, los ajustes, el detalle,
                // el esqueleto de carga o el mensaje de lista vacía.
                Rectangle {
                    vertical-stretch: 1;
                    clip: true;

                    // No se destruye al abrir un título: así, al volver, la lista sigue donde estaba.
                    ListView {
                        width: parent.width;
                        height: parent.height;
                        visible: !root.detail-open && !root.settings-open;

                        // Primera y última fila visibles: las miniaturas se piden solo para ellas.
                        changed viewport-y => {
                            root.visible-rows-changed(
                                max(0, floor(-self.content-y / (root.card-width * 9 / 16 + 64px))),
                                max(0, ceil((-self.content-y + self.visible-height) / (root.card-width * 9 / 16 + 64px)))
                            );
                        }

                        for row in root.rows : HorizontalLayout {
                            spacing: 16px;
                            height: root.card-width * 9 / 16 + 48px + 16px;

                            for card in row.cards : CardView {
                                card-width: root.card-width;
                                data: card;
                                activated => { root.card-clicked(card.index); }
                            }
                        }
                    }

                    if root.activity == Activity.catalog && root.rows.length == 0 && !root.detail-open && !root.settings-open : VerticalLayout {
                        width: parent.width;
                        spacing: 16px;

                        for line in [0, 1] : HorizontalLayout {
                            spacing: 16px;

                            for slot in root.skeleton-slots : CardSkeleton {
                                card-width: root.card-width;
                                pulse: root.pulse;
                            }
                        }
                    }

                    if root.activity == Activity.idle && root.rows.length == 0 && root.empty-message != "" && !root.detail-open && !root.settings-open : VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        alignment: center;
                        spacing: 12px;

                        Text {
                            text: root.empty-message;
                            color: root.status-error ? Theme.error : Theme.muted;
                            font-size: 14px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        if root.status-error : HorizontalLayout {
                            alignment: center;

                            PlayButton {
                                label: "Reintentar";
                                primary: true;
                                width: 130px;
                                clicked => { root.refresh-requested(); }
                            }
                        }
                    }

                    if root.settings-open : VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 4px;

                        HorizontalLayout {
                            height: 44px;
                            spacing: 8px;

                            IconButton {
                                glyph: "back";
                                hint: "Volver";
                                clicked => { root.back-requested(); }
                            }

                            Text {
                                text: "Ajustes";
                                color: Theme.text;
                                font-size: 22px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        ScrollView {
                            vertical-stretch: 1;

                            VerticalLayout {
                                padding-right: 12px;
                                padding-bottom: 16px;
                                spacing: 6px;

                                for row[i] in root.settings-rows : SettingRowView {
                                    data: row;
                                    index: i;
                                    clicked(index) => { root.setting-clicked(index); }
                                }
                            }
                        }
                    }

                    // Pantalla de un título o de una serie: de fondo, su imagen; encima, el título, la
                    // sinopsis y los botones. Una serie suma sus temporadas y episodios debajo.
                    if root.detail-open && !root.settings-open : page := Rectangle {
                        width: parent.width;
                        height: parent.height;
                        background: Theme.surface;
                        border-radius: 12px;
                        clip: true;

                        ScrollView {
                            width: parent.width;
                            height: parent.height;

                            VerticalLayout {
                                alignment: start;

                                // Un título llena toda la pantalla; una serie deja ver el comienzo de sus
                                // episodios abajo, para que se note que hay más.
                                hero := Rectangle {
                                    height: root.detail-series
                                        ? max(info.preferred-height + 48px, min(info.preferred-height + 160px, page.height - 90px))
                                        : max(info.preferred-height + 140px, page.height);
                                    clip: true;

                                    // La miniatura de la tarjeta: se ve al instante, borrosa.
                                    Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: root.detail-thumb;
                                        image-fit: cover;
                                        visible: root.detail-has-thumb;
                                    }

                                    // La imagen grande: aparece de a poco cuando llega.
                                    Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: root.detail-image;
                                        image-fit: cover;
                                        opacity: root.detail-image-ready ? 1 : 0;
                                        animate opacity { duration: 400ms; easing: ease-out; }
                                    }

                                    // Degradado a la izquierda y abajo: el texto se lee sobre cualquier imagen.
                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        width: parent.width * 0.85;
                                        height: parent.height;
                                        // Dos paradas nomás: con tres, el renderizador por software dibuja una línea en el empalme.
                                        background: @linear-gradient(90deg, Theme.surface.transparentize(0.06) 0%, Theme.surface.transparentize(1) 100%);
                                    }

                                    Rectangle {
                                        x: 0px;
                                        y: parent.height * 0.45;
                                        width: parent.width;
                                        height: parent.height * 0.55;
                                        background: @linear-gradient(180deg, Theme.surface.transparentize(1) 0%, Theme.surface 100%);
                                    }

                                    // Volver: redondo y translúcido, se ve sobre cualquier imagen.
                                    Rectangle {
                                        x: 16px;
                                        y: 16px;
                                        width: 36px;
                                        height: 36px;
                                        border-radius: 18px;
                                        background: back-touch.pressed ? #000000d0 : back-touch.has-hover ? #000000a8 : #00000080;
                                        animate background { duration: 120ms; }

                                        Icon {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            glyph: "back";
                                            size: 18px;
                                            tint: #ffffff;
                                        }

                                        back-touch := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            mouse-cursor: pointer;
                                            clicked => { root.back-requested(); }
                                        }
                                    }

                                    info := VerticalLayout {
                                        x: 32px;
                                        y: parent.height - self.preferred-height - 28px;
                                        width: min(parent.width - 64px, 640px);
                                        height: self.preferred-height;
                                        spacing: 12px;

                                        Text {
                                            text: root.detail-title;
                                            color: Theme.text;
                                            font-size: 30px;
                                            font-weight: 700;
                                            wrap: word-wrap;
                                        }

                                        if root.detail-subtitle != "" : Text {
                                            text: root.detail-subtitle;
                                            color: Theme.text.transparentize(0.2);
                                            font-size: 13px;
                                            wrap: word-wrap;
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;

                                            HeroButton {
                                                glyph: "play";
                                                label: root.activity == Activity.preparing ? "Preparando…" : root.detail-play-label;
                                                primary: true;
                                                available: root.activity != Activity.preparing;
                                                clicked => { root.play-requested(); }
                                            }

                                            HeroButton {
                                                glyph: root.detail-favorite ? "check" : "plus";
                                                label: root.favorite-label;
                                                clicked => { root.favorite-requested(); }
                                            }
                                        }

                                        if root.detail-text != "" : Text {
                                            text: root.detail-text;
                                            color: Theme.text;
                                            font-size: 14px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                if root.detail-series : VerticalLayout {
                                    padding-left: 20px;
                                    padding-right: 28px;
                                    padding-top: 8px;
                                    padding-bottom: 20px;
                                    spacing: 8px;

                                    Text {
                                        x: 12px;
                                        text: "Episodios";
                                        color: Theme.text;
                                        font-size: 18px;
                                        font-weight: 700;
                                        height: 32px;
                                        vertical-alignment: center;
                                    }

                                    if root.chips.length > 1 : ScrollView {
                                        height: 38px;
                                        content-height: 30px;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            height: 30px;
                                            padding-left: 12px;

                                            for name[i] in root.chips : Chip {
                                                label: name;
                                                active: i == root.chip-index;
                                                clicked => { root.chip-clicked(i); }
                                            }
                                        }
                                    }

                                    for ep in root.episodes : EpisodeRow {
                                        data: ep;
                                        clicked => { root.episode-clicked(ep.index); }
                                    }
                                }
                            }
                        }
                    }
                }

                }

                // Barra del reproductor (mpv corre en su propia ventana; esto controla mpv).
                if root.playing : Rectangle {
                    height: 108px;
                    background: Theme.surface;
                    border-radius: 12px;

                    VerticalLayout {
                        padding-top: 10px;
                        padding-bottom: 10px;
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 6px;

                        HorizontalLayout {
                            spacing: 8px;
                            height: 18px;

                            // Punto que pulsa mientras el buffer se llena (centrado con el título).
                            Rectangle {
                                width: 8px;

                                Rectangle {
                                    y: 5px;
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: Theme.accent;
                                    opacity: root.play-buffering ? (root.pulse ? 0.25 : 1) : 0;
                                    animate opacity { duration: 700ms; easing: ease-in-out; }
                                }
                            }

                            Text {
                                horizontal-stretch: 1;
                                text: root.play-title;
                                color: Theme.text;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                                wrap: no-wrap;
                                overflow: elide;
                            }

                            Text {
                                text: root.play-status + "   " + root.play-time;
                                color: root.play-buffering ? Theme.accent : Theme.muted;
                                font-size: 12px;
                                vertical-alignment: center;
                                wrap: no-wrap;
                            }
                        }

                        Rectangle {
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.surface-hi;

                            Rectangle {
                                x: 0px;
                                width: parent.width * root.play-progress;
                                height: parent.height;
                                border-radius: 3px;
                                background: Theme.accent;
                                opacity: root.play-buffering ? (root.pulse ? 0.45 : 1) : 1;
                                animate opacity { duration: 700ms; easing: ease-in-out; }
                            }

                            TouchArea {
                                x: 0px;
                                y: -6px;
                                width: parent.width;
                                height: parent.height + 12px;
                                mouse-cursor: pointer;
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down) {
                                        root.seek-to-requested(self.mouse-x / self.width);
                                    }
                                }
                            }
                        }

                        // Tres grupos: volumen y calidad a la izquierda, el transporte al centro, y a la
                        // derecha lo que cambia la imagen o el sonido.
                        HorizontalLayout {
                            spacing: 8px;

                            HorizontalLayout {
                                horizontal-stretch: 1;
                                alignment: start;
                                spacing: 2px;

                                IconButton {
                                    glyph: "volume-down";
                                    hint: "Bajar volumen";
                                    clicked => { root.volume-requested(-10); }
                                }

                                IconButton {
                                    glyph: "volume-up";
                                    hint: "Subir volumen";
                                    clicked => { root.volume-requested(10); }
                                }

                                if !root.audio-only : Rectangle {
                                    width: quality-text.preferred-width + 20px;
                                    height: 28px;
                                    y: 4px;
                                    border-radius: 14px;
                                    background: quality-touch.pressed ? Theme.surface-hi
                                        : quality-touch.has-hover ? Theme.hover
                                        : transparent;
                                    border-width: 1px;
                                    border-color: Theme.surface-hi;
                                    animate background { duration: 120ms; }

                                    quality-text := Text {
                                        x: 10px;
                                        height: parent.height;
                                        text: root.quality-label;
                                        color: Theme.text;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        wrap: no-wrap;
                                    }

                                    quality-touch := TouchArea {
                                        width: parent.width;
                                        height: parent.height;
                                        mouse-cursor: pointer;
                                        clicked => { root.quality-requested(); }
                                    }
                                }
                            }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 4px;

                                if root.queue-controls : IconButton {
                                    glyph: "shuffle";
                                    hint: root.shuffle-on ? "Aleatorio: sí" : "Aleatorio: no";
                                    active: root.shuffle-on;
                                    clicked => { root.shuffle-requested(); }
                                }

                                IconButton {
                                    glyph: "prev";
                                    hint: "Anterior";
                                    available: root.can-step-prev;
                                    clicked => { root.prev-requested(); }
                                }

                                IconButton {
                                    glyph: "rewind";
                                    badge: "10";
                                    hint: "Retroceder 10 s";
                                    clicked => { root.seek-requested(-10); }
                                }

                                IconButton {
                                    glyph: root.play-paused ? "play" : "pause";
                                    hint: root.play-paused ? "Seguir" : "Pausa";
                                    primary: true;
                                    diameter: 44px;
                                    clicked => { root.toggle-pause-requested(); }
                                }

                                IconButton {
                                    glyph: "forward";
                                    badge: "10";
                                    hint: "Adelantar 10 s";
                                    clicked => { root.seek-requested(10); }
                                }

                                IconButton {
                                    glyph: "next";
                                    hint: "Siguiente";
                                    available: root.can-step-next;
                                    clicked => { root.next-requested(); }
                                }

                                if root.queue-controls : IconButton {
                                    glyph: "repeat";
                                    badge: root.repeat-mode == 2 ? "1" : "";
                                    hint: root.repeat-mode == 0 ? "Repetir: no" : root.repeat-mode == 1 ? "Repetir: todo" : "Repetir: una";
                                    active: root.repeat-mode != 0;
                                    clicked => { root.repeat-requested(); }
                                }
                            }

                            HorizontalLayout {
                                horizontal-stretch: 1;
                                alignment: end;
                                spacing: 2px;

                                if !root.audio-only : IconButton {
                                    glyph: "audio";
                                    hint: "Idioma del audio";
                                    clicked => { root.audio-cycle-requested(); }
                                }

                                if !root.audio-only : IconButton {
                                    glyph: "subtitles";
                                    hint: "Subtítulos";
                                    clicked => { root.subtitle-cycle-requested(); }
                                }

                                if root.lyrics-open : IconButton {
                                    glyph: "lyrics";
                                    hint: root.lyrics-visible ? "Ocultar letra" : "Ver letra";
                                    active: root.lyrics-visible;
                                    clicked => {
                                        root.lyrics-visible = !root.lyrics-visible;
                                        if (!root.lyrics-visible) { root.lyrics-wide = false; }
                                    }
                                }

                                IconButton {
                                    glyph: "fullscreen";
                                    hint: "Pantalla completa";
                                    clicked => { root.fullscreen-requested(); }
                                }

                                IconButton {
                                    glyph: "stop";
                                    hint: "Detener";
                                    clicked => { root.stop-requested(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Paneles de la derecha. Van después del contenido para dibujarse encima: antes quedaban debajo
    // y las portadas tapaban el texto.

    // Guía de programación: lo que está al aire y lo que sigue, con sus horas.
    if root.guide-open : Rectangle {
        x: root.width - 332px;
        y: 20px;
        width: 312px;
        height: root.height - 20px - root.panel-bottom;
        background: Theme.surface;
        border-radius: 12px;
        clip: true;

        VerticalLayout {
            padding: 14px;
            spacing: 8px;
            alignment: start;

            Text {
                text: "Programación";
                color: Theme.text;
                font-size: 14px;
                font-weight: 700;
                height: 24px;
            }

            for row in root.guide-rows : HorizontalLayout {
                spacing: 8px;

                Text {
                    text: row.time;
                    color: row.current ? Theme.accent : Theme.muted;
                    font-size: 12px;
                    font-weight: row.current ? 600 : 400;
                    vertical-alignment: top;
                    min-width: 40px;
                }

                Text {
                    text: row.title;
                    color: row.current ? Theme.accent : Theme.text;
                    font-size: 13px;
                    font-weight: row.current ? 600 : 400;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }
    }

    // Letra de la canción que suena. En su columna, o (con el botón de expandir) ocupando todo el
    // contenido, para leerla sin nada más detrás.
    if root.lyrics-shown : Rectangle {
        x: root.lyrics-wide ? 220px : root.width - 332px;
        y: 20px;
        width: root.lyrics-wide ? root.width - 260px : 312px;
        height: root.height - 20px - root.panel-bottom;
        background: Theme.surface;
        border-radius: 12px;
        clip: true;

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            HorizontalLayout {
                height: 32px;
                spacing: 4px;

                Icon {
                    y: 7px;
                    glyph: "lyrics";
                    size: 18px;
                    tint: Theme.accent;
                }

                Text {
                    horizontal-stretch: 1;
                    text: "Letra";
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                IconButton {
                    glyph: root.lyrics-wide ? "collapse" : "expand";
                    hint: root.lyrics-wide ? "Achicar" : "Ver sola";
                    diameter: 32px;
                    clicked => { root.lyrics-wide = !root.lyrics-wide; }
                }

                IconButton {
                    glyph: "close";
                    hint: "Ocultar letra";
                    diameter: 32px;
                    clicked => {
                        root.lyrics-visible = false;
                        root.lyrics-wide = false;
                    }
                }
            }

            VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                spacing: root.lyrics-wide ? 14px : 10px;

                for row in root.lyrics-rows : Text {
                    text: row.text;
                    color: row.current ? Theme.accent : Theme.muted;
                    font-size: root.lyrics-wide ? (row.current ? 26px : 18px) : (row.current ? 16px : 13px);
                    font-weight: row.current ? 600 : 400;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }

    // Chat: columna a la derecha, por encima de la barra del reproductor. Se muestran las últimas
    // líneas, pegadas abajo.
    if root.chat-open : Rectangle {
        x: root.width - 332px;
        y: 20px;
        width: 312px;
        height: root.height - 20px - root.panel-bottom;
        background: Theme.surface;
        border-radius: 12px;
        clip: true;

        VerticalLayout {
            padding: 10px;
            spacing: 6px;
            alignment: end;

            for line in root.chat-lines : HorizontalLayout {
                spacing: 6px;

                Text {
                    text: line.author;
                    color: line.color;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: top;
                    wrap: no-wrap;
                    overflow: elide;
                    max-width: 110px;
                }

                Text {
                    text: line.text;
                    color: line.notice ? Theme.accent : Theme.text;
                    font-size: 12px;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}
