// Interfaz de media-lite. Todo el estado vive en Rust; acá solo se dibuja y se avisan los clics.
// GPL-3.0-or-later.

import { ListView, ScrollView } from "std-widgets.slint";
// Inter (SIL OFL 1.1, ver app/assets/fonts/OFL.txt): Slint las embebe en el binario.
import "../assets/fonts/Inter-Regular.ttf";
import "../assets/fonts/Inter-SemiBold.ttf";

// Qué está haciendo la app mientras no hay un video reproduciéndose. Lo fija Rust.
export enum Activity {
    idle,
    // Pidiendo un listado, una búsqueda o las temporadas de una serie.
    catalog,
    // Pidiendo la fuente de un video, antes de que mpv se abra.
    preparing,
}

// Escala de espacios: 4, 8, 12, 16 y 24 px. Tipos: 11, 12, 13, 14, 18 y 22 px.
// Los estados (hover, pulsado) salen de aclarar u oscurecer el color base.
export global Theme {
    in-out property <bool> dark: true;
    out property <color> bg: dark ? #0f1115 : #f2f3f6;
    out property <color> side: dark ? #14171d : #e4e7ee;
    out property <color> surface: dark ? #1b1f28 : #ffffff;
    out property <color> surface-hi: dark ? #272d39 : #d9dde7;
    out property <color> hover: dark ? #222733 : #e9ecf3;
    out property <color> text: dark ? #e9ebf1 : #15171c;
    out property <color> muted: dark ? #8d95a7 : #5a6273;
    out property <color> accent: #7c9cff;
    out property <color> accent-hover: accent.brighter(0.15);
    out property <color> accent-press: accent.darker(0.2);
    out property <color> error: dark ? #ff8a80 : #c62828;
    out property <length> radius: 10px;
}

// Una línea del chat: autor y texto. `notice` es un aviso del sistema (suscripciones, cortes).
export struct ChatLine {
    author: string,
    text: string,
    color: color,
    notice: bool,
}

export struct CardData {
    title: string,
    subtitle: string,
    thumb: image,
    has-thumb: bool,
    index: int,
}

export struct SettingRow {
    label: string,
    value: string,
    note: string,
}

export struct RowData {
    cards: [CardData],
}

// Un episodio en la lista de la pantalla de una serie.
export struct EpisodeData {
    number: string,
    title: string,
    meta: string,
    description: string,
    thumb: image,
    has-thumb: bool,
    index: int,
}

// Entrada de la barra lateral. Marca la activa con una franja a la izquierda y se aclara al pasar el mouse.
component NavButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();

    height: 34px;
    border-radius: 8px;
    background: root.active ? Theme.surface-hi
        : touch.pressed ? Theme.surface-hi
        : touch.has-hover ? Theme.hover
        : transparent;
    animate background { duration: 120ms; }

    Rectangle {
        x: 0px;
        y: parent.height * 0.25;
        width: 3px;
        height: parent.height * 0.5;
        border-radius: 2px;
        background: root.active ? Theme.accent : transparent;
    }

    Text {
        x: 14px;
        width: parent.width - 26px;
        height: parent.height;
        text: root.label;
        color: root.active ? Theme.text : Theme.muted;
        font-size: 14px;
        font-weight: root.active ? 600 : 400;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component CardView inherits Rectangle {
    in property <CardData> data;
    in property <length> card-width;
    callback activated();

    width: root.card-width;
    height: root.card-width * 9 / 16 + 48px;

    VerticalLayout {
        spacing: 6px;

        Rectangle {
            height: root.card-width * 9 / 16;
            border-radius: Theme.radius;
            clip: true;
            background: Theme.surface-hi;
            border-width: touch.has-hover ? 2px : 0px;
            border-color: Theme.accent;
            animate border-width { duration: 120ms; }

            Image {
                width: parent.width;
                height: parent.height;
                source: root.data.thumb;
                image-fit: cover;
                visible: root.data.has-thumb;
            }

            // Al pasar el mouse: un velo con la acción, así se ve qué tarjeta es la que se va a abrir.
            Rectangle {
                width: parent.width;
                height: parent.height;
                background: touch.pressed ? #000000a0 : #00000040;
                opacity: touch.has-hover ? 1 : 0;
                animate opacity { duration: 120ms; }

                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 64px;
                    height: 26px;
                    border-radius: 13px;
                    background: Theme.accent;

                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: "Abrir";
                        color: #ffffff;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Text {
            text: root.data.title;
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
            wrap: no-wrap;
            overflow: elide;
        }

        Text {
            text: root.data.subtitle;
            color: Theme.muted;
            font-size: 11px;
            wrap: no-wrap;
            overflow: elide;
        }
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

// Marcador de una tarjeta mientras carga el catálogo. Pulsa al mismo ritmo que el resto.
component CardSkeleton inherits Rectangle {
    in property <length> card-width;
    in property <bool> pulse;

    width: root.card-width;
    height: root.card-width * 9 / 16 + 48px;

    VerticalLayout {
        spacing: 6px;

        Rectangle {
            height: root.card-width * 9 / 16;
            border-radius: Theme.radius;
            background: Theme.surface-hi;
            opacity: root.pulse ? 0.45 : 1;
            animate opacity { duration: 700ms; easing: ease-in-out; }
        }

        Rectangle {
            height: 12px;
            width: parent.width * 0.8;
            border-radius: 4px;
            background: Theme.surface-hi;
            opacity: root.pulse ? 0.45 : 1;
            animate opacity { duration: 700ms; easing: ease-in-out; }
        }

        Rectangle {
            height: 10px;
            width: parent.width * 0.5;
            border-radius: 4px;
            background: Theme.surface-hi;
            opacity: root.pulse ? 0.45 : 1;
            animate opacity { duration: 700ms; easing: ease-in-out; }
        }
    }
}

// Botón de acción. Primario o secundario; se deshabilita con `available`.
component PlayButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> available: true;
    callback clicked();

    min-width: 64px;
    height: 34px;
    border-radius: 8px;
    background: !root.available ? Theme.surface-hi
        : root.primary ? (touch.pressed ? Theme.accent-press : touch.has-hover ? Theme.accent-hover : Theme.accent)
        : touch.pressed ? Theme.surface
        : touch.has-hover ? Theme.hover
        : Theme.surface-hi;
    opacity: root.available ? 1 : 0.4;
    animate background { duration: 120ms; }

    Text {
        x: 2px;
        width: parent.width - 4px;
        height: parent.height;
        text: root.label;
        color: root.primary ? #ffffff : Theme.text;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: no-wrap;
        overflow: elide;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.available;
        mouse-cursor: root.available ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Botón grande de la pantalla de un título: ícono y texto. El principal va en el color de acento.
component HeroButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> available: true;
    callback clicked();

    height: 40px;
    width: 18px + (root.icon == "" ? 0px : icon-text.preferred-width + 8px) + label-text.preferred-width + 18px;
    border-radius: 8px;
    background: !root.available ? Theme.surface-hi
        : root.primary ? (touch.pressed ? Theme.accent-press : touch.has-hover ? Theme.accent-hover : Theme.accent)
        : touch.pressed ? Theme.surface
        : touch.has-hover ? Theme.hover
        : Theme.surface-hi;
    opacity: root.available ? 1 : 0.5;
    animate background { duration: 120ms; }

    icon-text := Text {
        x: 18px;
        height: parent.height;
        text: root.icon;
        color: root.primary ? #ffffff : Theme.text;
        font-size: 14px;
        vertical-alignment: center;
        visible: root.icon != "";
    }

    label-text := Text {
        x: 18px + (root.icon == "" ? 0px : icon-text.preferred-width + 8px);
        height: parent.height;
        text: root.label;
        color: root.primary ? #ffffff : Theme.text;
        font-size: 14px;
        font-weight: 600;
        vertical-alignment: center;
        wrap: no-wrap;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.available;
        mouse-cursor: root.available ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// Un episodio: número, miniatura, título con su duración y sinopsis. Un clic lo reproduce.
component EpisodeRow inherits Rectangle {
    in property <EpisodeData> data;
    callback clicked();

    height: 104px;
    border-radius: 10px;
    background: touch.pressed ? Theme.surface-hi : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding: 12px;
        spacing: 16px;

        Text {
            width: 28px;
            text: root.data.number;
            color: Theme.muted;
            font-size: 20px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            width: 142px;
            border-radius: 8px;
            clip: true;
            background: Theme.surface-hi;

            Image {
                width: parent.width;
                height: parent.height;
                source: root.data.thumb;
                image-fit: cover;
                visible: root.data.has-thumb;
            }

            // Al pasar el mouse: un velo con el botón de reproducir.
            Rectangle {
                width: parent.width;
                height: parent.height;
                background: #00000066;
                opacity: touch.has-hover ? 1 : 0;
                animate opacity { duration: 120ms; }

                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 34px;
                    height: 34px;
                    border-radius: 17px;
                    background: Theme.accent;

                    Text {
                        x: 2px;
                        width: parent.width;
                        height: parent.height;
                        text: "▶";
                        color: #ffffff;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;

            HorizontalLayout {
                spacing: 12px;

                Text {
                    horizontal-stretch: 1;
                    text: root.data.title;
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    wrap: no-wrap;
                    overflow: elide;
                }

                Text {
                    text: root.data.meta;
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: no-wrap;
                }
            }

            // Tres renglones como mucho: lo que sobra se corta con «…».
            if root.data.description != "" : Text {
                text: root.data.description;
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
                overflow: elide;
                max-height: 44px;
            }
        }
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Fila de la pantalla de Ajustes: nombre y nota a la izquierda, valor a la derecha.
component SettingRowView inherits Rectangle {
    in property <SettingRow> data;
    in property <int> index;
    callback clicked(int);

    height: 52px;
    border-radius: 10px;
    background: touch.pressed ? Theme.surface-hi : touch.has-hover ? Theme.hover : Theme.surface;
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.data.label;
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
                wrap: no-wrap;
                overflow: elide;
            }

            Text {
                text: root.data.note;
                color: Theme.muted;
                font-size: 11px;
                wrap: no-wrap;
                overflow: elide;
            }
        }

        Rectangle {
            width: 150px;
            height: 32px;
            border-radius: 8px;
            background: Theme.surface-hi;

            Text {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: root.data.value;
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
            }
        }
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(root.index); }
    }
}

// Chip de categoría o de temporada.
component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();

    height: 30px;
    width: label-text.preferred-width + 24px;
    border-radius: 15px;
    background: root.active ? Theme.accent
        : touch.pressed ? Theme.surface-hi
        : touch.has-hover ? Theme.hover
        : Theme.surface;
    animate background { duration: 120ms; }

    label-text := Text {
        x: 12px;
        height: parent.height;
        text: root.label;
        color: root.active ? #ffffff : Theme.muted;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "media-lite";
    background: Theme.bg;
    default-font-family: "Inter";
    preferred-width: 1024px;
    preferred-height: 640px;
    // Lo mínimo para que quepan los nueve controles del reproductor en una fila sin cortar el texto.
    min-width: 940px;
    min-height: 440px;

    in property <[string]> platforms;
    in property <int> platform-index: 0;
    in property <[string]> sections;
    in property <int> section-index: 1;
    in property <[RowData]> rows;
    in property <int> columns: 4;
    in property <string> status;
    in property <bool> status-error;
    in property <Activity> activity: Activity.idle;
    // Texto centrado cuando la lista está vacía o falló (ej.: «No se pudo cargar…»).
    in property <string> empty-message;
    in property <bool> detail-open;
    in property <string> detail-title;
    in property <string> detail-subtitle;
    in property <string> detail-text;
    in property <bool> playing;
    // Chat del directo o de la grabación, a la derecha de la grilla (ver app/src/chat.rs).
    in property <bool> chat-open;
    in property <[ChatLine]> chat-lines;
    in property <string> play-title;
    in property <string> play-time;
    in property <float> play-progress;
    in property <bool> play-paused;
    in property <bool> play-buffering;
    in property <string> play-status;
    in property <[string]> chips;
    in property <bool> settings-open;
    in property <int> library-index: -1;
    in property <bool> detail-favorite;
    in property <string> favorite-label: "Favoritos";
    // Pantalla de un título: la miniatura de la tarjeta (se ve mientras llega la imagen grande),
    // la imagen grande, y si el título es una serie (con su lista de episodios).
    in property <image> detail-thumb;
    in property <bool> detail-has-thumb;
    in property <image> detail-image;
    in property <bool> detail-image-ready;
    in property <bool> detail-series;
    in property <string> detail-play-label: "Reproducir";
    in property <[EpisodeData]> episodes;
    in property <[SettingRow]> settings-rows;
    in property <int> chip-index: 0;
    in property <bool> can-step-prev;
    in property <bool> can-step-next;

    callback play-requested();
    callback toggle-pause-requested();
    callback seek-requested(float);
    callback seek-to-requested(float);
    callback stop-requested();
    callback fullscreen-requested();
    callback audio-cycle-requested();
    callback subtitle-cycle-requested();
    callback prev-requested();
    callback next-requested();
    callback chip-clicked(int);
    callback settings-requested();
    callback library-clicked(int);
    callback favorite-requested();
    callback episode-clicked(int);
    callback visible-rows-changed(int, int);
    callback setting-clicked(int);

    callback platform-clicked(int);
    callback section-clicked(int);
    callback search-submitted(string);
    callback card-clicked(int);
    callback refresh-requested();
    callback back-requested();
    callback theme-toggled();
    callback width-changed(float);

    property <length> card-width: (root.width - 200px - 40px - (root.columns - 1) * 16px) / root.columns;
    // Lugares del esqueleto: uno por columna. Lo fija Rust (ver `state::sync_skeleton`).
    in property <[int]> skeleton-slots;
    // Alterna cada 700 ms mientras algo carga o se está bufferizando: mueve la barra y pulsa los esqueletos.
    property <bool> pulse;
    property <bool> loading: root.activity != Activity.idle;

    Timer {
        interval: 700ms;
        running: root.loading || root.play-buffering;
        triggered => { root.pulse = !root.pulse; }
    }

    forward-focus: keys;

    // Chat: columna superpuesta a la derecha, por encima de la barra del reproductor. Se muestran
    // las últimas líneas, pegadas abajo.
    if root.chat-open : Rectangle {
        x: root.width - 328px;
        y: 12px;
        width: 312px;
        height: root.height - 136px;
        background: Theme.surface;
        border-radius: 12px;
        clip: true;

        VerticalLayout {
            padding: 10px;
            spacing: 6px;
            alignment: end;

            for line in root.chat-lines : HorizontalLayout {
                spacing: 6px;

                Text {
                    text: line.author;
                    color: line.color;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: top;
                    wrap: no-wrap;
                    overflow: elide;
                    max-width: 110px;
                }

                Text {
                    text: line.text;
                    color: line.notice ? Theme.accent : Theme.text;
                    font-size: 12px;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }
    }

    keys := FocusScope {
        width: parent.width;
        height: parent.height;

        changed width => { root.width-changed(self.width / 1px); }

        key-pressed(event) => {
            if (event.text == "/") {
                search.focus();
                return accept;
            }
            if (event.text == Key.F5) {
                root.refresh-requested();
                return accept;
            }
            if (event.text == Key.Return && root.detail-open && !root.settings-open && !search.has-focus) {
                root.play-requested();
                return accept;
            }
            if ((event.text == Key.Escape || event.text == Key.Backspace) && (root.detail-open || root.settings-open)) {
                root.back-requested();
                return accept;
            }
            // Controles del video: solo si el foco no está en el buscador.
            if (root.playing && !search.has-focus) {
                if (event.text == " ") {
                    root.toggle-pause-requested();
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    root.seek-requested(-10);
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    root.seek-requested(10);
                    return accept;
                }
                if (event.text == "<" && root.can-step-prev) {
                    root.prev-requested();
                    return accept;
                }
                if (event.text == ">" && root.can-step-next) {
                    root.next-requested();
                    return accept;
                }
            }
            return reject;
        }

        HorizontalLayout {
            // Barra lateral: la navegación se desplaza si no entra; Ajustes y Tema quedan siempre abajo.
            Rectangle {
                width: 200px;
                background: Theme.side;

                VerticalLayout {
                    padding: 16px;
                    spacing: 4px;

                    Text {
                        text: "media-lite";
                        color: Theme.text;
                        font-size: 18px;
                        font-weight: 700;
                        height: 32px;
                    }

                    ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: 4px;

                            Text {
                                text: "PLATAFORMAS";
                                color: Theme.muted;
                                font-size: 11px;
                                height: 26px;
                                vertical-alignment: bottom;
                            }

                            for name[i] in root.platforms : NavButton {
                                label: name;
                                active: i == root.platform-index;
                                clicked => { root.platform-clicked(i); }
                            }

                            Text {
                                text: "SECCIONES";
                                color: Theme.muted;
                                font-size: 11px;
                                height: 26px;
                                vertical-alignment: bottom;
                            }

                            for name[i] in root.sections : NavButton {
                                label: name;
                                active: i == root.section-index;
                                clicked => { root.section-clicked(i); }
                            }

                            Text {
                                text: "BIBLIOTECA";
                                color: Theme.muted;
                                font-size: 11px;
                                height: 26px;
                                vertical-alignment: bottom;
                            }

                            NavButton {
                                label: "Inicio";
                                active: root.library-index == 0;
                                clicked => { root.library-clicked(0); }
                            }

                            NavButton {
                                label: "Historial";
                                active: root.library-index == 1;
                                clicked => { root.library-clicked(1); }
                            }

                            NavButton {
                                label: "Favoritos";
                                active: root.library-index == 2;
                                clicked => { root.library-clicked(2); }
                            }

                            NavButton {
                                label: "Siguiendo";
                                active: root.library-index == 3;
                                clicked => { root.library-clicked(3); }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.surface-hi;
                    }

                    NavButton {
                        label: "Ajustes";
                        active: root.settings-open;
                        clicked => { root.settings-requested(); }
                    }

                    NavButton {
                        label: Theme.dark ? "Tema claro" : "Tema oscuro";
                        active: false;
                        clicked => { root.theme-toggled(); }
                    }
                }
            }

            // Contenido
            VerticalLayout {
                padding: 20px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 12px;
                    height: 38px;

                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.surface;
                        border-radius: 8px;
                        border-width: search.has-focus ? 1px : 0px;
                        border-color: Theme.accent;

                        Text {
                            x: 14px;
                            width: parent.width - 28px;
                            height: parent.height;
                            text: "Buscar…   (tecla /)";
                            color: Theme.muted;
                            font-size: 14px;
                            vertical-alignment: center;
                            visible: search.text == "";
                        }

                        search := TextInput {
                            x: 14px;
                            width: parent.width - 28px;
                            height: parent.height;
                            color: Theme.text;
                            font-size: 14px;
                            vertical-alignment: center;
                            accepted => { root.search-submitted(self.text); }
                        }
                    }

                    Rectangle {
                        width: 40px;
                        background: refresh-touch.pressed ? Theme.surface-hi : refresh-touch.has-hover ? Theme.hover : Theme.surface;
                        border-radius: 8px;
                        animate background { duration: 120ms; }

                        Text {
                            text: "⟳";
                            color: Theme.text;
                            font-size: 18px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        refresh-touch := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: pointer;
                            clicked => { root.refresh-requested(); }
                        }
                    }
                }

                // Barra de carga: siempre reserva su lugar (sin saltos) y se desliza mientras algo carga.
                Rectangle {
                    height: 3px;
                    border-radius: 2px;
                    clip: true;
                    background: Theme.surface-hi;
                    opacity: root.loading ? 1 : 0;
                    animate opacity { duration: 200ms; }

                    Rectangle {
                        width: parent.width * 0.25;
                        height: parent.height;
                        border-radius: 2px;
                        background: Theme.accent;
                        x: root.pulse ? parent.width * 0.75 : 0px;
                        animate x { duration: 700ms; easing: ease-in-out; }
                    }
                }

                Text {
                    text: root.status;
                    color: root.status-error ? Theme.error : Theme.muted;
                    font-size: 12px;
                    height: 16px;
                    wrap: no-wrap;
                    overflow: elide;
                }

                if root.chips.length > 0 && !root.settings-open && !root.detail-open : ScrollView {
                    height: 34px;
                    content-height: 30px;

                    HorizontalLayout {
                        spacing: 8px;
                        height: 30px;

                        for name[i] in root.chips : Chip {
                            label: name;
                            active: i == root.chip-index;
                            clicked => { root.chip-clicked(i); }
                        }
                    }
                }

                // Área de contenido: un solo lugar donde se muestra la grilla, los ajustes, el detalle,
                // el esqueleto de carga o el mensaje de lista vacía.
                Rectangle {
                    vertical-stretch: 1;
                    clip: true;

                    // No se destruye al abrir un título: así, al volver, la lista sigue donde estaba.
                    ListView {
                        width: parent.width;
                        height: parent.height;
                        visible: !root.detail-open && !root.settings-open;

                        // Primera y última fila visibles: las miniaturas se piden solo para ellas.
                        changed viewport-y => {
                            root.visible-rows-changed(
                                max(0, floor(-self.content-y / (root.card-width * 9 / 16 + 64px))),
                                max(0, ceil((-self.content-y + self.visible-height) / (root.card-width * 9 / 16 + 64px)))
                            );
                        }

                        for row in root.rows : HorizontalLayout {
                            spacing: 16px;
                            height: root.card-width * 9 / 16 + 48px + 16px;

                            for card in row.cards : CardView {
                                card-width: root.card-width;
                                data: card;
                                activated => { root.card-clicked(card.index); }
                            }
                        }
                    }

                    if root.activity == Activity.catalog && root.rows.length == 0 && !root.detail-open && !root.settings-open : VerticalLayout {
                        width: parent.width;
                        spacing: 16px;

                        for line in [0, 1] : HorizontalLayout {
                            spacing: 16px;

                            for slot in root.skeleton-slots : CardSkeleton {
                                card-width: root.card-width;
                                pulse: root.pulse;
                            }
                        }
                    }

                    if root.activity == Activity.idle && root.rows.length == 0 && root.empty-message != "" && !root.detail-open && !root.settings-open : VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        alignment: center;
                        spacing: 12px;

                        Text {
                            text: root.empty-message;
                            color: root.status-error ? Theme.error : Theme.muted;
                            font-size: 14px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        if root.status-error : HorizontalLayout {
                            alignment: center;

                            PlayButton {
                                label: "Reintentar";
                                primary: true;
                                width: 130px;
                                clicked => { root.refresh-requested(); }
                            }
                        }
                    }

                    if root.settings-open : VerticalLayout {
                        width: parent.width;
                        height: parent.height;
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: start;

                            PlayButton {
                                label: "← Volver";
                                width: 120px;
                                clicked => { root.back-requested(); }
                            }
                        }

                        ListView {
                            vertical-stretch: 1;

                            for row[i] in root.settings-rows : SettingRowView {
                                data: row;
                                index: i;
                                clicked(index) => { root.setting-clicked(index); }
                            }
                        }
                    }

                    // Pantalla de un título o de una serie: de fondo, su imagen; encima, el título, la
                    // sinopsis y los botones. Una serie suma sus temporadas y episodios debajo.
                    if root.detail-open && !root.settings-open : page := Rectangle {
                        width: parent.width;
                        height: parent.height;
                        background: Theme.surface;
                        border-radius: 12px;
                        clip: true;

                        ScrollView {
                            width: parent.width;
                            height: parent.height;

                            VerticalLayout {
                                alignment: start;

                                // Un título llena toda la pantalla; una serie deja ver el comienzo de sus
                                // episodios abajo, para que se note que hay más.
                                hero := Rectangle {
                                    height: root.detail-series
                                        ? max(info.preferred-height + 48px, min(info.preferred-height + 160px, page.height - 90px))
                                        : max(info.preferred-height + 140px, page.height);
                                    clip: true;

                                    // La miniatura de la tarjeta: se ve al instante, borrosa.
                                    Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: root.detail-thumb;
                                        image-fit: cover;
                                        visible: root.detail-has-thumb;
                                    }

                                    // La imagen grande: aparece de a poco cuando llega.
                                    Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: root.detail-image;
                                        image-fit: cover;
                                        opacity: root.detail-image-ready ? 1 : 0;
                                        animate opacity { duration: 400ms; easing: ease-out; }
                                    }

                                    // Degradado a la izquierda y abajo: el texto se lee sobre cualquier imagen.
                                    Rectangle {
                                        x: 0px;
                                        y: 0px;
                                        width: parent.width * 0.85;
                                        height: parent.height;
                                        // Dos paradas nomás: con tres, el renderizador por software dibuja una línea en el empalme.
                                        background: @linear-gradient(90deg, Theme.surface.transparentize(0.06) 0%, Theme.surface.transparentize(1) 100%);
                                    }

                                    Rectangle {
                                        x: 0px;
                                        y: parent.height * 0.45;
                                        width: parent.width;
                                        height: parent.height * 0.55;
                                        background: @linear-gradient(180deg, Theme.surface.transparentize(1) 0%, Theme.surface 100%);
                                    }

                                    // Volver: redondo y translúcido, se ve sobre cualquier imagen.
                                    Rectangle {
                                        x: 16px;
                                        y: 16px;
                                        width: 36px;
                                        height: 36px;
                                        border-radius: 18px;
                                        background: back-touch.pressed ? #000000d0 : back-touch.has-hover ? #000000a8 : #00000080;
                                        animate background { duration: 120ms; }

                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: "←";
                                            color: #ffffff;
                                            font-size: 18px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        back-touch := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            mouse-cursor: pointer;
                                            clicked => { root.back-requested(); }
                                        }
                                    }

                                    info := VerticalLayout {
                                        x: 32px;
                                        y: parent.height - self.preferred-height - 28px;
                                        width: min(parent.width - 64px, 640px);
                                        height: self.preferred-height;
                                        spacing: 12px;

                                        Text {
                                            text: root.detail-title;
                                            color: Theme.text;
                                            font-size: 30px;
                                            font-weight: 700;
                                            wrap: word-wrap;
                                        }

                                        if root.detail-subtitle != "" : Text {
                                            text: root.detail-subtitle;
                                            color: Theme.text.transparentize(0.2);
                                            font-size: 13px;
                                            wrap: word-wrap;
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;
                                            alignment: start;

                                            HeroButton {
                                                icon: "▶";
                                                label: root.activity == Activity.preparing ? "Preparando…" : root.detail-play-label;
                                                primary: true;
                                                available: root.activity != Activity.preparing;
                                                clicked => { root.play-requested(); }
                                            }

                                            HeroButton {
                                                icon: root.detail-favorite ? "✓" : "+";
                                                label: root.favorite-label;
                                                clicked => { root.favorite-requested(); }
                                            }
                                        }

                                        if root.detail-text != "" : Text {
                                            text: root.detail-text;
                                            color: Theme.text;
                                            font-size: 14px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                if root.detail-series : VerticalLayout {
                                    padding-left: 20px;
                                    padding-right: 28px;
                                    padding-top: 8px;
                                    padding-bottom: 20px;
                                    spacing: 8px;

                                    Text {
                                        x: 12px;
                                        text: "Episodios";
                                        color: Theme.text;
                                        font-size: 18px;
                                        font-weight: 700;
                                        height: 32px;
                                        vertical-alignment: center;
                                    }

                                    if root.chips.length > 1 : ScrollView {
                                        height: 38px;
                                        content-height: 30px;

                                        HorizontalLayout {
                                            spacing: 8px;
                                            height: 30px;
                                            padding-left: 12px;

                                            for name[i] in root.chips : Chip {
                                                label: name;
                                                active: i == root.chip-index;
                                                clicked => { root.chip-clicked(i); }
                                            }
                                        }
                                    }

                                    for ep in root.episodes : EpisodeRow {
                                        data: ep;
                                        clicked => { root.episode-clicked(ep.index); }
                                    }
                                }
                            }
                        }
                    }
                }

                // Barra del reproductor (mpv corre en su propia ventana; esto controla mpv).
                if root.playing : Rectangle {
                    height: 108px;
                    background: Theme.surface;
                    border-radius: 12px;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 8px;

                            // Punto que pulsa mientras el buffer se llena (centrado con el título).
                            Rectangle {
                                width: 8px;
                                height: 18px;

                                Rectangle {
                                    y: 5px;
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: Theme.accent;
                                    opacity: root.play-buffering ? (root.pulse ? 0.25 : 1) : 0;
                                    animate opacity { duration: 700ms; easing: ease-in-out; }
                                }
                            }

                            Text {
                                horizontal-stretch: 1;
                                text: root.play-title;
                                color: Theme.text;
                                font-size: 13px;
                                font-weight: 600;
                                wrap: no-wrap;
                                overflow: elide;
                            }

                            Text {
                                text: root.play-status + "   " + root.play-time;
                                color: root.play-buffering ? Theme.accent : Theme.muted;
                                font-size: 12px;
                                wrap: no-wrap;
                            }
                        }

                        Rectangle {
                            height: 6px;
                            border-radius: 3px;
                            background: Theme.surface-hi;

                            Rectangle {
                                x: 0px;
                                width: parent.width * root.play-progress;
                                height: parent.height;
                                border-radius: 3px;
                                background: Theme.accent;
                                opacity: root.play-buffering ? (root.pulse ? 0.45 : 1) : 1;
                                animate opacity { duration: 700ms; easing: ease-in-out; }
                            }

                            TouchArea {
                                x: 0px;
                                y: -6px;
                                width: parent.width;
                                height: parent.height + 12px;
                                mouse-cursor: pointer;
                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down) {
                                        root.seek-to-requested(self.mouse-x / self.width);
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;

                            PlayButton {
                                label: root.play-paused ? "Seguir" : "Pausa";
                                primary: true;
                                horizontal-stretch: 2;
                                clicked => { root.toggle-pause-requested(); }
                            }

                            PlayButton {
                                label: "−10 s";
                                horizontal-stretch: 1;
                                clicked => { root.seek-requested(-10); }
                            }

                            PlayButton {
                                label: "+10 s";
                                horizontal-stretch: 1;
                                clicked => { root.seek-requested(10); }
                            }

                            PlayButton {
                                label: "Anterior";
                                horizontal-stretch: 1;
                                available: root.can-step-prev;
                                clicked => { root.prev-requested(); }
                            }

                            PlayButton {
                                label: "Siguiente";
                                horizontal-stretch: 1;
                                available: root.can-step-next;
                                clicked => { root.next-requested(); }
                            }

                            PlayButton {
                                label: "Idioma";
                                horizontal-stretch: 1;
                                clicked => { root.audio-cycle-requested(); }
                            }

                            PlayButton {
                                label: "Subs";
                                horizontal-stretch: 1;
                                clicked => { root.subtitle-cycle-requested(); }
                            }

                            PlayButton {
                                label: "Completa";
                                horizontal-stretch: 1;
                                clicked => { root.fullscreen-requested(); }
                            }

                            PlayButton {
                                label: "Detener";
                                horizontal-stretch: 1;
                                clicked => { root.stop-requested(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
